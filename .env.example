# ── 대본 생성 (Gemini) ──────────────────────────────
# 키 여러 개는 콤마로 구분하면 라운드로빈 로테이션
GEMINI_API_KEYS=key1,key2,key3,key4
GEMINI_MODEL=gemini-2.5-flash

# ── 이미지 (선택) ───────────────────────────────────
# 비워두면 뉴스 이미지 + 기사 캡처 + 그라디언트 배경만 사용
PEXELS_API_KEY=

# ── YouTube 업로드 ──────────────────────────────────
# 로컬 최초 인증: config/client_secret.json 두고 `python scripts/setup_youtube_token.py`
# CI: 아래 값을 GitHub Secret YOUTUBE_TOKEN_JSON 에 등록 (JSON 문자열)
YOUTUBE_TOKEN_JSON=

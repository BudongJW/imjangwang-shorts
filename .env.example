# ── 대본 생성 (Gemini) ──────────────────────────────
# 키 여러 개는 콤마로 구분하면 라운드로빈 로테이션
GEMINI_API_KEYS=key1,key2,key3,key4
GEMINI_MODEL=gemini-2.5-flash

# ── 화면 (선택) ─────────────────────────────────────
# 움직임 묶음(자막 어절 강조, 카드 등장 움직임, 컷 팬, 기사 화면 전환). 0이면 끈다.
MOTION_FX=1
# 나레이션의 문장 사이 공백을 0.25초로 줄인다. 0이면 TTS가 준 그대로 쓴다.
PAUSE_TRIM=1
# 이름표(말한 사람·출처·임장왕 체크). 움직임 묶음이 켜져 있을 때만 쓴다. 0이면 이름표만 끈다.
NAME_TAGS=1

# ── 이미지 (선택) ───────────────────────────────────
# 비워두면 뉴스 이미지 + 기사 캡처 + 그라디언트 배경만 사용
PEXELS_API_KEY=

# ── YouTube 업로드 ──────────────────────────────────
# 로컬 최초 인증: config/client_secret.json 두고 `python scripts/setup_youtube_token.py`
# CI: 아래 값을 GitHub Secret YOUTUBE_TOKEN_JSON 에 등록 (JSON 문자열)
YOUTUBE_TOKEN_JSON=

# 썸네일 AI 이미지 생성(Gemini image, AQ. 포맷 키)
GEMINI_IMAGE_KEY=
GEMINI_IMAGE_MODEL=gemini-2.5-flash-image
